{
    "name": "sen12ms_cr_diffcr_test",
    "phase": "test",
    "gpu_ids": [
        0
    ],
    "seed": -1,
    "distributed": false,
    "finetune_norm": false,
    "path": {
        "base_dir": "experiments",
        "code": "code",
        "tb_logger": "tb_logger",
        "results": "results",
        "checkpoint": "checkpoint",
        "resume_state": "/kaggle/input/diffcr/pytorch/default/1/diffcr_new.pth"
    },
    "datasets": {
        "test": {
            "which_dataset": {
                "name": "SEN12MS_CR_RGB",
                "args": {
                    "data_root": "/kaggle/input/sen12ms-cr-winter",
                    "mode": "test",
                    "data_csv": "/kaggle/working/data.csv"
                }
            },
            "dataloader": {
                "args": {
                    "batch_size": 1,
                    "num_workers": 2,
                    "pin_memory": true,
                    "shuffle": false
                }
            }
        },
        "val": {
            "which_dataset": {
                "name": "SEN12MS_CR_RGB",
                "args": {
                    "data_root": "/kaggle/input/sen12ms-cr-winter",
                    "mode": "val",
                    "data_csv": "/kaggle/working/data.csv"
                }
            }
        }
    },
    "model": {
        "which_model": {
            "name": [
                "models.model",
                "Palette"
            ],
            "args": {
                "sample_num": 8,
                "task": "decloud",
                "ema_scheduler": {
                    "ema_start": 1,
                    "ema_iter": 1,
                    "ema_decay": 0.9999
                }
            }
        },
        "which_networks": [
            {
                "name": [
                    "models.network_x0_dpm_solver",
                    "Network"
                ],
                "args": {
                    "init_type": "kaiming",
                    "module_name": "ours_double_encoder_splitcaCond_splitcaUnet",
                    "unet": {
                        "in_channel": 6,
                        "out_channel": 3,
                        "inner_channel": 64,
                        "channel_mults": [
                            1,
                            2,
                            4,
                            8,
                            8
                        ],
                        "attn_res": [
                            8
                        ],
                        "num_head_channels": 32,
                        "res_blocks": 2,
                        "dropout": 0,
                        "image_size": 256
                    },
                    "beta_schedule": {
                        "test": {
                            "schedule": "sigmoid",
                            "n_timestep": 1000,
                            "linear_start": 0.0001,
                            "linear_end": 0.09
                        }
                    }
                }
            }
        ],
        "which_losses": [
            "mse_loss"
        ],
        "which_metrics": [
            "mae"
        ]
    },
    "train": {
        "n_epoch": 1,
        "n_iter": 1,
        "val_epoch": 1,
        "save_checkpoint_epoch": 1,
        "log_iter": 1,
        "tensorboard": false
    }
}